{
  "name": "merch-store-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express + MongoDB API for the merch store (auth, products, orders, payments, delivery tracking).",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node seed/seedProducts.js",
    "migrate:variants": "node seed/migrateSizesToVariants.js",
    "test": "node --require ./tests/setupEnv.js --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --require ./tests/setupEnv.js --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:integration": "node --require ./tests/setupEnv.js --test --test-reporter=spec \"tests/integration/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
