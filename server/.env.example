# Copy this file to .env and fill in the values.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (local install, Docker, or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/merch-store

# Auth — use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# If "true", login also requires the browser's GPS coords to be inside the service area
# (customers only; admins and drivers are exempt). Easy to spoof, so treat it as a soft check.
STRICT_LOGIN_GEOFENCE=false

# Service area (defaults: Toronto City Hall, 25 km)
SERVICE_CENTER_LAT=43.6534
SERVICE_CENTER_LNG=-79.3841
SERVICE_RADIUS_KM=25

# Geocoding: "mock" (offline lookup of GTA city names, good for dev/tests) or "nominatim" (OpenStreetMap)
GEOCODER=mock
# Nominatim requires an identifying User-Agent with contact info and max 1 request/second.
GEOCODER_USER_AGENT=merch-store-dev (contact: you@example.com)

# Payments: "stripe" or "mock" (mock lets you test checkout without any keys; disabled in production)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Store name used at the start of text messages
STORE_NAME=SEM Merch

# SMS updates: "mock" (prints texts to the console) or "twilio"
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxx
# A Twilio number that can text Canadian numbers, in E.164 format
TWILIO_FROM_NUMBER=+15555550100

# Canada Post Developer Portal (Tracking API). Keep false until you have credentials.
CANADA_POST_ENABLED=false
CP_API_BASE=https://api.canadapost-postescanada.ca/prod/devportal-portaildesdeveloppeurs
# Copy the token URL and scope from the portal's "Try it" tab
CP_TOKEN_URL=
CP_TOKEN_SCOPE=
CP_API_KEY=
CP_API_SECRET=
# Check Canada Post every N minutes inside the API process (0 = off; use `npm run poll:carriers` on a schedule)
CARRIER_POLL_MINUTES=0

# Uber Direct (on-demand couriers inside the GTA). Sign up at https://direct.uber.com
# "mock" = fake quotes/deliveries for local testing; "live" = real API (test-mode keys use Uber's sandbox)
UBER_DIRECT_ENABLED=false
UBER_DIRECT_MODE=mock
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Dashboard → Developer → Webhooks → your webhook → Edit → signing key
UBER_WEBHOOK_SIGNING_KEY=
# Your store/warehouse (where couriers pick up)
UBER_PICKUP_NAME=SEM Merch
UBER_PICKUP_PHONE=+14165550100
UBER_PICKUP_LINE1=
UBER_PICKUP_CITY=Toronto
UBER_PICKUP_PROVINCE=ON
UBER_PICKUP_POSTAL_CODE=
UBER_PICKUP_LAT=43.6534
UBER_PICKUP_LNG=-79.3841
UBER_PICKUP_NOTES=
