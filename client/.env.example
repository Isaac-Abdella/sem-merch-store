# Copy to .env. Vite only exposes variables that start with VITE_ (they end up in the browser —
# never put secret keys here).

# Leave empty in development to use the Vite proxy (recommended). In production set your API origin,
# e.g. https://api.yourstore.ca/api
VITE_API_URL=

# Socket.io server origin. Leave empty in development (uses the proxy).
VITE_SOCKET_URL=

# Stripe PUBLISHABLE key (pk_test_...). Only needed when the server uses PAYMENT_PROVIDER=stripe.
VITE_STRIPE_PUBLISHABLE_KEY=

# Map tiles. OpenStreetMap's tiles are fine for development; for production traffic use a tile
# provider (MapTiler, Stadia, Mapbox...) and put its URL template + key here.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
